include LICENSE
include README.md
recursive-include sunnynet/runtime *.c *.h
recursive-include sunnynet/kernels *.c *.h
exclude docs/COMMUNITY_*.md
exclude docs/DISCUSSIONS_*.md
prune experiments
prune data
prune runs
prune .ref
# 本机编译缓存, 不入包
prune sunnynet/runtime/_build
prune sunnynet/kernels/_build
# 预编译库由 wheel 构建期生成, sdist 只带源码
prune sunnynet/_prebuilt
